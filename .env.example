# Public, non-secret chain configuration.
# The token address is public information, not a credential.

# Robinhood Chain mainnet
VITE_CHAIN_ID=4663

# Canonical $WIF contract. Leave unset to run in read-only verification mode:
# invoices can still be checked, but the pay action stays disabled.
# Candidate confirmed on-chain as name="World is Flat", symbol="WIF", 18 decimals.
# Awaiting organizer confirmation before any mainnet payment is enabled.
VITE_WIF_TOKEN_ADDRESS=

# Optional read provider. The public RPC is rate-limited.
# Do not commit a provider key that grants write access.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
